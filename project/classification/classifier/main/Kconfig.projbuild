menu "Classifier Configuration"

config CLASSIFIER_MODEL_PATH
    string "ESP-DL model path"
    default "/sdcard/model.espdl"
    help
        Path to the ESP-DL model file.

config CLASSIFIER_IMAGE_FOLDER
    string "Image folder"
    default "/sdcard/images"
    help
        Directory containing JPEG images to classify.

config CLASSIFIER_INPUT_SCALE
    float "Input quantization scale"
    default 0.0078125
    help
        Input tensor scale used by the quantized model.

config CLASSIFIER_INPUT_ZERO_POINT
    int "Input quantization zero point"
    default 0
    help
        Input tensor zero point used by the quantized model.

config CLASSIFIER_USE_EMBEDDED_MODEL
    bool "Use embedded model"
    default y
    help
        Load model from flash instead of SD card.

config CLASSIFIER_MAX_IMAGE_FILES
    int "Maximum image files"
    range 1 10000
    default 1000
    help
        Maximum number of JPEG files processed in a single run.

config CLASSIFIER_ENABLE_RECURSIVE_SCAN
    bool "Enable recursive directory scan"
    default n
    help
        Search for images in subdirectories.

config CLASSIFIER_LOG_TOP5
    bool "Print Top-5 predictions"
    default n
    help
        Print the five highest scoring classes.

config CLASSIFIER_RUNTIME_MODE_MULTICORE
    bool "Use ESP-DL multi-core runtime"
    default y
    help
        Enables dl::RUNTIME_MODE_MULTI_CORE.

config CLASSIFIER_INPUT_WIDTH
    int "Input width"
    range 32 1024
    default 224

config CLASSIFIER_INPUT_HEIGHT
    int "Input height"
    range 32 1024
    default 224

config CLASSIFIER_INPUT_CHANNELS
    int "Input channels"
    range 1 4
    default 3

endmenu
